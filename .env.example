# Copy to .env (never commit .env). Any OpenAI-compatible endpoint works.

# Jarvislabs Token Factory serving Google's open-weight Gemma (default)
SEANCE_LLM_BASE_URL=https://models.jarvislabs.net/v1
SEANCE_LLM_MODEL=gemma-4-26b-a4b-it
SEANCE_LLM_API_KEY=

# Fully local and offline instead, with Ollama (`ollama pull gemma3:4b`):
# SEANCE_LLM_BASE_URL=http://localhost:11434/v1
# SEANCE_LLM_MODEL=gemma3:4b
# SEANCE_LLM_API_KEY=

# Public demo guard rails
# SEANCE_DEMO_REPOS=psf/requests,pallets/flask,expressjs/express,jquery/jquery
# SEANCE_ALLOW_REMOTE=1
# SEANCE_MAX_REPO_MB=300
# SEANCE_LLM_CALLS_PER_IP_HOUR=60
# SEANCE_LLM_CALLS_PER_DAY=3000
# SEANCE_TRUST_PROXY=0   # set to 1 behind a reverse proxy (Render, Fly, nginx)
# SEANCE_CACHE_DIR=
